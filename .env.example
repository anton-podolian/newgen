# Hugging Face token with Inference Providers permission.
HF_TOKEN=hf_your_token_here
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# fal-ai is the current live provider for SDXL 1.0 and supports LoRA parameters.
IMAGE_API_URL=https://router.huggingface.co/fal-ai/fal-ai/fast-sdxl
# Public LoRA file to apply to SDXL.
LORA_WEIGHT_NAME=Anime.safetensors
IMAGE_API_TIMEOUT=120
GRADIO_CONCURRENCY=1
PORT=7860
LOG_LEVEL=INFO
